{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "e3-ci-web",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "containers": [
    {
      "class_name": "E3ApiContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-4",
      "max_instances": 2,
      "rollout_active_grace_period": 1800
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "E3_API",
        "class_name": "E3ApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["E3ApiContainer"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "E3_OBJECTS",
      "bucket_name": "e3-ci-private-objects"
    }
  ],
  "vars": {
    "ACCESS_AUTH_MODE": "disabled",
    "LOCAL_WORKSPACE_ID": "e3-ci-production",
    "LOCAL_OWNER_ID": "e3-ci-internal",
    "LOCAL_ACTOR_ID": "public-web-user",
    "LOCAL_ACTOR_DISPLAY_NAME": "Public web user",
    "CI_SCENARIO_PROCESS_WORKERS": "3"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}

# Local-only defaults used by scripts/dev.sh.
DATABASE_URL=sqlite+pysqlite:///./.local/e3_ci_analyzer.sqlite3
OBJECT_STORE_ROOT=.local/object_store
OBJECT_STORE_BACKEND=filesystem
# Cloudflare Containers uses the Worker-to-R2 bridge instead of local disk.
# OBJECT_STORE_HTTP_BASE_URL=http://e3-r2.internal
CI_TARIFF_PROFILE_PATH=.local/ci/active-tariff-profile.json
DURABLE_API_AUTH_MODE=loopback_development
DURABLE_API_BEARER_TOKEN=ci-local-development-only
LOCAL_WORKSPACE_ID=local-workspace
LOCAL_OWNER_ID=local-analyst
LOCAL_ACTOR_ID=local-analyst
LOCAL_ACTOR_DISPLAY_NAME=Local analyst
E3_API_PORT=18080
E3_WEB_PORT=15173
